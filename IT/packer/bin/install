#!/bin/bash
set -e

sudo apt update -y
DEBIAN_FRONTEND=noninteractive \
sudo apt install -y ca-certificates sudo apt-transport-https \
software-properties-common

# No Ansible here: the deploy playbook runs from the control machine over SSH,
# and its first task bootstraps the Python it needs.
DEBIAN_FRONTEND=noninteractive \
sudo apt install -y python3 python3-minimal python3-venv python3-apt


# Clean up
DEBIAN_FRONTEND=noninteractive sudo apt -y autoremove
DEBIAN_FRONTEND=noninteractive sudo apt -y autoclean
sudo rm -rf /tmp/*.gz /tmp/*.zip /tmp/geckodriver* /tmp/aws*
