#!/bin/bash
set -e

sudo apt update -y
DEBIAN_FRONTEND=noninteractive \
sudo apt install -y ca-certificates sudo apt-transport-https \
software-properties-common

sudo apt-add-repository --y --update ppa:ansible/ansible

DEBIAN_FRONTEND=noninteractive \
sudo apt install -y ansible python3 python3-minimal python3-pip python3-apt


# Clean up
DEBIAN_FRONTEND=noninteractive sudo apt -y autoremove
DEBIAN_FRONTEND=noninteractive sudo apt -y autoclean
sudo rm -rf /tmp/*.gz /tmp/*.zip /tmp/geckodriver* /tmp/aws*
