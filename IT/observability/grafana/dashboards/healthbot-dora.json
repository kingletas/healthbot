{
  "uid": "healthbot-dora",
  "title": "HealthBot DORA",
  "description": "Four of DORA's five metrics as trends over time, with no performance tiers. Computed by healthbot-dora export from the deploy journal. Deployment rework rate is not collected.",
  "tags": [
    "healthbot",
    "dora"
  ],
  "schemaVersion": 39,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "title": "Deployment frequency",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (metric) (healthbot_dora_metric{metric=\"deployment_frequency_per_day\"})",
          "legendFormat": "per day",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "graphMode": "area",
        "colorMode": "none"
      },
      "id": 1,
      "description": "Deploys per day over the window. Computed by healthbot-dora export from the deploy journal."
    },
    {
      "title": "Lead time for changes",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (metric) (healthbot_dora_metric{metric=\"lead_time_seconds\"})",
          "legendFormat": "lead time",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "graphMode": "area",
        "colorMode": "none"
      },
      "id": 2,
      "description": "Commit to deploy. Computed by healthbot-dora export from the deploy journal."
    },
    {
      "title": "Change failure rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (metric) (healthbot_dora_metric{metric=\"change_failure_ratio\"})",
          "legendFormat": "failure rate",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "graphMode": "area",
        "colorMode": "none"
      },
      "id": 3,
      "description": "Share of deploys that needed a fix. Computed by healthbot-dora export from the deploy journal."
    },
    {
      "title": "Failed deployment recovery time",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (metric) (healthbot_dora_metric{metric=\"mttr_seconds\"})",
          "legendFormat": "MTTR",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "graphMode": "area",
        "colorMode": "none"
      },
      "id": 4,
      "description": "Incident to resolve, the metric DORA now calls failed deployment recovery time. Computed by healthbot-dora export from the deploy journal."
    },
    {
      "title": "Lead time and failed deployment recovery time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (metric) (healthbot_dora_metric{metric=\"lead_time_seconds\"})",
          "legendFormat": "lead time",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (metric) (healthbot_dora_metric{metric=\"mttr_seconds\"})",
          "legendFormat": "failed deployment recovery time",
          "refId": "B"
        }
      ],
      "id": 5,
      "description": "Both in seconds, so they share an axis honestly."
    },
    {
      "title": "Deployment frequency and change failure rate",
      "description": "Deploys per day on the left, the share that failed on the right.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "change failure rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "failure rate"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (metric) (healthbot_dora_metric{metric=\"deployment_frequency_per_day\"})",
          "legendFormat": "deploys per day",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (metric) (healthbot_dora_metric{metric=\"change_failure_ratio\"})",
          "legendFormat": "change failure rate",
          "refId": "B"
        }
      ],
      "id": 6
    },
    {
      "title": "Deployment rework rate",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Not collected.** DORA's fifth metric is the share of deployments that were unplanned and made to fix an incident. The deploy journal does not record whether a deploy was planned, so there is nothing to compute it from."
      },
      "id": 7,
      "description": "Why this metric has no panel."
    }
  ]
}
