{
  "uid": "healthbot-sre",
  "title": "HealthBot SRE \u2014 SLOs and checks",
  "tags": [
    "healthbot",
    "slo"
  ],
  "schemaVersion": 39,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "title": "SLO compliance (30d window)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.98
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:healthbot_compliance:ratio_30d",
          "legendFormat": "{{slo}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "id": 1
    },
    {
      "title": "Error-budget burn rate \u2014 1h window (page at 14.4, ticket at 6)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:healthbot_burn_rate:rate1h",
          "legendFormat": "{{slo}}",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "title": "Error ratio \u2014 5m window",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:healthbot_error_ratio:rate5m",
          "legendFormat": "{{slo}}",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "title": "Check results by status (runs/min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (check, status) (rate(healthbot_check_result_total[5m])) * 60",
          "legendFormat": "{{check}} \u00b7 {{status}}",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "title": "Check duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, check) (rate(healthbot_check_duration_seconds_bucket[5m])))",
          "legendFormat": "{{check}}",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "title": "GA active users",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "healthbot_site_active_users",
          "legendFormat": "active users",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "title": "APM response time \u2014 app (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "healthbot_apm_response_time{tier=\"app\"}",
          "legendFormat": "app (ms)",
          "refId": "A"
        }
      ],
      "id": 7
    },
    {
      "title": "Browser response time \u2014 web (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "healthbot_apm_response_time{tier=\"web\"}",
          "legendFormat": "web (s)",
          "refId": "A"
        }
      ],
      "id": 8
    },
    {
      "title": "Canary probes by status code",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (url, status_code) (rate(healthbot_probe_http_status_total{status_code!=\"200\"}[5m])) * 60",
          "legendFormat": "{{url}} \u2192 {{status_code}}",
          "refId": "A"
        }
      ],
      "description": "Non-200 responses per minute; empty is good",
      "id": 9
    },
    {
      "title": "Heartbeat (runs/min) \u2014 the dead-man's switch",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum (rate(healthbot_heartbeat_total[15m])) * 60",
          "legendFormat": "runs/min",
          "refId": "A"
        }
      ],
      "id": 10
    }
  ]
}