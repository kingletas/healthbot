{
  "uid": "healthbot-sre",
  "title": "HealthBot SRE \u2014 SLOs and checks",
  "tags": [
    "healthbot",
    "slo"
  ],
  "schemaVersion": 39,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "title": "How far each SLO is above its target (30-day window)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(\n    slo:healthbot_compliance:ratio_30d\n    - on (slo) group_left (description, objective)\n    max by (slo, description, objective) (healthbot_slo_target)\n)",
          "legendFormat": "{{description}} \u00b7 target {{objective}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "id": 1,
      "description": "Thirty-day compliance minus the objective, in percentage points, so zero is exactly on target and the sign is the verdict. Each tile carries the sentence and the target from config/slo.yml, which is the only place an objective is written."
    },
    {
      "title": "Error-budget burn rate \u2014 1h window (page at 14.4, ticket at 6)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:healthbot_burn_rate:rate1h",
          "legendFormat": "{{slo}}",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "title": "Error ratio \u2014 5m window",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:healthbot_error_ratio:rate5m",
          "legendFormat": "{{slo}}",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "title": "Check results by status (runs/min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (check, status) (rate(healthbot_check_result_total[5m])) * 60",
          "legendFormat": "{{check}} \u00b7 {{status}}",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "title": "Check duration p95 across recent runs",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, check) (max_over_time(healthbot_check_duration_seconds_bucket[15m])))",
          "legendFormat": "{{check}}",
          "refId": "A"
        }
      ],
      "id": 5,
      "description": "Every oneshot run emits its own single-sample series, so the quantile is taken over the runs with a sample in the last 15 minutes rather than over a rate. The collector holds a run for 10 minutes, so that reaches back about 25 minutes."
    },
    {
      "title": "GA active users",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "axisSoftMax": 700
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 700
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(healthbot_site_active_users)",
          "legendFormat": "worst run in view",
          "refId": "A"
        }
      ],
      "id": 6,
      "description": "Realtime active users. site.yml alerts at or above 700."
    },
    {
      "title": "APM response time, app tier",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "axisSoftMax": 800
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 800
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(healthbot_apm_response_time{tier=\"app\"})",
          "legendFormat": "worst run in view",
          "refId": "A"
        }
      ],
      "id": 7,
      "description": "New Relic APM response time, in milliseconds as New Relic reports it. site.yml alerts at or above 800 ms."
    },
    {
      "title": "Browser response time, web tier",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "axisSoftMax": 3.5
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3.5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(healthbot_apm_response_time{tier=\"web\"})",
          "legendFormat": "worst run in view",
          "refId": "A"
        }
      ],
      "id": 8,
      "description": "New Relic browser response time, in seconds as New Relic reports it. site.yml alerts at or above 3.5 s."
    },
    {
      "title": "Canary URLs by status code",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (url, status_code) (rate(healthbot_canary_http_status_total{status_code!=\"200\"}[5m])) * 60",
          "legendFormat": "{{url}} \u2192 {{status_code}}",
          "refId": "A"
        }
      ],
      "description": "Non-200 responses per minute; empty is good",
      "id": 9
    },
    {
      "title": "Runs reporting (the dead-man's switch pages at zero)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(healthbot_heartbeat_total) or on() vector(0)",
          "legendFormat": "runs reporting",
          "refId": "A"
        }
      ],
      "id": 10,
      "description": "Completed runs still inside the collector's 10-minute retention. At the 5-minute timer cadence a healthy bot holds 2 or 3; HealthBotSilent pages when the series is gone altogether."
    }
  ]
}
