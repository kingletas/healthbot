# The store's compose project, as `docker compose ls` shows it. Its network and Varnish volume are
# named after it.
STORE_PROJECT=kapelos-shop
# Written by `kapelos db exporter-user`, readable only by its owner.
EXPORTER_MY_CNF=/path/to/kapelos/var/sites/shop/exporter.my.cnf
HOST_UID=1000
# The image the store's Varnish runs, so varnishstat reads its shared memory in the same format.
VARNISH_IMAGE=varnish:8.0
# From the sha256 checksum file published beside the exporter's release.
VARNISH_EXPORTER_SHA256=510e89628ca46da6f2e54618e2e6b68144cb034445024aa93c45d36ab20e16d3
